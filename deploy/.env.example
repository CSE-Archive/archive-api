# Copy the relevant parts of this file to TWO places on the VM (see README):
#
#   /opt/csearchive/.env    -> only DB_PASSWORD (compose interpolation)
#   /opt/csearchive/api.env -> everything else (API runtime env)
#
# NOTE (docker compose v5): `$` inside env files is interpolated. Values
# containing a literal `$` (like the SECRET_KEY below) must be stored
# `$`-doubled (`$$`) or they get silently mangled.

# --- api.env ------------------------------------------------------------

# Must be False in production.
DEBUG=False

# Django secret. The production value deliberately reuses the old server's
# key (from the archive-backup zip) so restored signed data stays valid.
SECRET_KEY=<generate-or-reuse>
# SECRET_KEY=with$$dollars$$escaped

ALLOWED_HOSTS=api.csearchive.ir,www.api.csearchive.ir,csearchive-web,api,localhost

# Regex of origins allowed to call the API cross-origin (the SPA).
CORS_ALLOWED_ORIGIN_REGEXES=^https://(www\.)?csearchive\.ir$

# Needed for admin logins over https behind the TLS-terminating Caddy.
CSRF_TRUSTED_ORIGINS=https://api.csearchive.ir,https://www.api.csearchive.ir
BEHIND_PROXY=True

DB_NAME=csearchive
DB_USER=csearchive
DB_PASSWORD=<same value as DB_PASSWORD below>
DB_HOST=db
DB_PORT=5432

# --- .env (compose) ------------------------------------------------------

DB_PASSWORD=<openssl rand -hex 24>

# Name of the external docker network owned by the reverse proxy's compose
# stack on this VM (deployment-specific; get it from the operator notes).
PROXY_NETWORK=<external reverse-proxy network name>
